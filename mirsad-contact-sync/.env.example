# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Empty admin token = open demo mode: anyone who can reach the server can read and change the list.
SCAMSHIELD_ADMIN_TOKEN=
# Token the phones send. Only checked when SCAMSHIELD_ADMIN_TOKEN is set.
SCAMSHIELD_DEVICE_TOKEN=
# ISO region for numbers written without +country code, for example AE. Empty = such numbers are rejected.
SCAMSHIELD_DEFAULT_REGION=
# Name of the contact on the phone. Empty = "⚠️ Known Scammer".
SCAMSHIELD_CONTACT_NAME=
