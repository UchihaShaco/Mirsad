    <!-- Onboarding -->
    <string name="onboarding_title">Protect this phone</string>
    <string name="onboarding_intro">Mirsad checks calls and messages on this phone and never uploads anything. Three permissions make the live protection work. You can try the Demo without any of them.</string>
    <string name="onb_call_title">Screen incoming calls</string>
    <string name="onb_call_why">Lets Mirsad see the number of an incoming call and reject a known scam number before it rings.</string>
    <string name="onb_notif_title">Read message notifications</string>
    <string name="onb_notif_why">Lets Mirsad read the text of new SMS and chat notifications and hide the ones it holds. Messages stay in their own apps.</string>
    <string name="onb_post_title">Show notices</string>
    <string name="onb_post_why">Lets Mirsad tell you when it holds or flags something, with a one-tap Not a scam.</string>
