# Mirsad (مرصاد) website shield. Copy to .env (git-ignored) and fill in what you need. docker compose reads it for every
# service. Variables keep the SCAMSHIELD_ prefix (the package is still named scamshield).

# --- Gateway: Tailscale exit node -------------------------------------------------------------
# Reusable or ephemeral auth key from https://login.tailscale.com/admin/settings/keys.
# Empty = the gateway prints a login URL in `docker compose logs gateway`.
TS_AUTHKEY=
# Node name in the tailnet (default scamshield-isp; kept because the running node is registered under it).
TS_HOSTNAME=scamshield-isp
# tailscale (phone via exit node) | wireguard (same Wi-Fi, proxy's built-in WireGuard) | explicit (proxy only)
GATEWAY_MODE=tailscale

# --- Gateway: decisions --------------------------------------------------------------------------
# 1 = full interception; only when the phone has the gateway CA installed (http://mitm.it, see
# docs/DEMO.md). Keep it here, not on the command line: compose re-reads it on every command.
SCAMSHIELD_INTERCEPT=0
# Longest time an unknown site's connection is held while the engine investigates (seconds).
SCAMSHIELD_HOLD_S=8
# What an unknown site gets when the engine is down or too slow: block | allow.
SCAMSHIELD_ON_TIMEOUT=block
# Warn-level sites seen only by hostname (no interception): allow | block.
SCAMSHIELD_WARN_OVER_TLS=allow
# Decision cache lifetime (seconds) for allowed/warned hosts and, shorter, for blocked hosts.
SCAMSHIELD_CACHE_TTL=10
SCAMSHIELD_BLOCK_CACHE_TTL=5
# Pages wait this long for a quick verdict before showing the "checking" page (seconds; 0 = always show it).
SCAMSHIELD_PAGE_GRACE_S=1
# Start investigating as soon as the phone resolves a name: 1 | 0.
SCAMSHIELD_DNS_PREFETCH=1
# Extra hosts never held or investigated (comma separated; subdomains included).
SCAMSHIELD_PASSTHROUGH=
# "Continue anyway" on a warning lasts this long per phone and host (seconds).
SCAMSHIELD_PROCEED_TTL=1800

# --- Host ports ----------------------------------------------------------------------------------
SCAMSHIELD_API_PORT=8000
SCAMSHIELD_PROXY_PORT=8081
SCAMSHIELD_WG_PORT=51820

# --- Engine (see src/scamshield/config.py for the full list) -------------------------------------
SCAMSHIELD_WARN=35
SCAMSHIELD_BLOCK=70
# A model server on this PC must listen on 0.0.0.0 and is addressed from the containers as
# host.docker.internal, e.g. SCAMSHIELD_LLM_BASE_URL=http://host.docker.internal:8001/v1
SCAMSHIELD_LLM_BASE_URL=
SCAMSHIELD_LLM_MODEL=
SCAMSHIELD_LLM_API_KEY=
# Fine-tuned page encoder service on the host GPU (start: see docs/BENCHMARKS_PAGE.md, "Serving").
# Empty = the CPU page model only. From the engine container: http://host.docker.internal:8003
SCAMSHIELD_PAGE_ENCODER_URL=
# auto | anthropic | openai (the OpenAI-compatible server above) | rules
SCAMSHIELD_REVIEW_PROVIDER=auto
ANTHROPIC_API_KEY=
BRAVE_SEARCH_API_KEY=
# Evidence packs: 0 disables page screenshots; the sensor name printed on reports (empty = mirsad-gateway-01).
SCAMSHIELD_EVIDENCE_SCREENSHOT=1
SCAMSHIELD_SENSOR_ID=
