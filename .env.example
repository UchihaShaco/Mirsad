# Mirsad configuration. Copy to .env (git-ignored) and adjust. Values shown are the defaults.
# Never put real secrets in this file.

# Bind address. Only 127.0.0.1, localhost or ::1 are accepted.
MIRSAD_HOST=127.0.0.1
# HTTP port (0 picks a free port).
MIRSAD_PORT=8787
# Database, evidence files and demo-credentials.json live here (git-ignored).
MIRSAD_DATA_DIR=./data
# Seed a demo workspace, officers, accounts and connector on first start with an empty database.
MIRSAD_DEMO_SEED=true

# Reviewer: lmstudio (default; local model), deterministic (offline rules) or disabled.
MIRSAD_REVIEWER=lmstudio
# Provider for Telegram replies in English and Emirati Arabic.
MIRSAD_REPLY_PROVIDER=lmstudio
# With openrouter, choose google/gemini-3.8-flash (default) or thedrummer/cydonia-24b-v4.1.
# MIRSAD_OPENROUTER_MODEL=google/gemini-3.8-flash
# OpenRouter key for the openrouter reply provider. Supply a real key only in the git-ignored .env file.
OPENROUTER_API_KEY=
# LM Studio OpenAI-compatible endpoint. The parsed hostname must be exactly 127.0.0.1, localhost or [::1].
MIRSAD_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Model ID loaded in LM Studio (default qwen3.5-9b: Qwen3.5 9B Q4_K_M).
MIRSAD_LMSTUDIO_MODEL=qwen3.5-9b
# Context length the model is loaded with.
MIRSAD_LMSTUDIO_CONTEXT_TOKENS=4096
# Optional separate local model for Arabic Telegram replies. Match its loaded ID and context.
# MIRSAD_LMSTUDIO_ARABIC_MODEL=
# MIRSAD_LMSTUDIO_ARABIC_CONTEXT_TOKENS=4096
# MIRSAD_LMSTUDIO_ARABIC_BASE_URL=http://127.0.0.1:1234/v1
# Per-request timeout in milliseconds.
MIRSAD_LMSTUDIO_TIMEOUT_MS=120000
# Number of chats reviewed in parallel (one review at a time per chat).
MIRSAD_REVIEW_CONCURRENCY=2
# Comma-separated capture methods that may be reviewed. telegram_business_live is never allowed.
MIRSAD_REVIEW_ALLOWED_CAPTURE_METHODS=fixture_replay

# Number of event-stream events kept per workspace.
MIRSAD_STREAM_RETENTION=5000
# Requests per minute allowed per token.
MIRSAD_RATE_LIMIT_PER_MINUTE=600

# WhatsApp import gate. Rejected at startup unless a valid Telegram controlled-test record exists.
MIRSAD_WHATSAPP_IMPORT_ENABLED=false
# Telegram controlled-test record that opens the WhatsApp gate (relative paths resolve from the project root).
MIRSAD_CONTROLLED_TEST_RECORD=docs/telegram/controlled-test-record.json

# Telegram live connector (read-only business updates). Stays off unless every value below is set.
TELEGRAM_LIVE_ENABLED=false
# Bot token from BotFather (secret: set only in .env).
TELEGRAM_BOT_TOKEN=
# Business connection ID approved for the controlled test.
TELEGRAM_APPROVED_CONNECTION_ID=
# Which chats are stored: approved (only TELEGRAM_APPROVED_CHAT_IDS) or all_private (every eligible private chat
# of the connected account, by the owner's decision; docs/telegram/setup.md, step 10).
TELEGRAM_CHAT_SCOPE=approved
# Private chats with recorded reply consent. In all-private intake, the Inbox switch also lets new DMs opt in.
TELEGRAM_APPROVED_CHAT_IDS=
# Reference of the owner's recorded decision to cover every private chat (required for all_private).
TELEGRAM_ALL_CHATS_REFERENCE=
# Comma-separated chat IDs never stored or answered, in either scope.
TELEGRAM_EXCLUDED_CHAT_IDS=
# Reference of the written approval for the controlled test.
TELEGRAM_APPROVAL_REFERENCE=

# Model-written replies in opted-in chats (docs/telegram/setup.md, steps 9–10).
# Needs the live connector, the bot's Reply to Messages right, the configured provider and consent below.
TELEGRAM_AI_REPLIES_ENABLED=false
# Reference of the recorded consent to automated replies.
TELEGRAM_AI_REPLY_CONSENT_REFERENCE=
# Start a chat that was never started when the contact's first answerable message arrives, instead of waiting for an
# officer's Dispatch (docs/telegram/setup.md, step 10).
TELEGRAM_AI_AUTO_START=false
