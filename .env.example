# Mirsad configuration. Copy to .env (git-ignored) and adjust. Values shown are the defaults.
# Never put real secrets in this file.

# Bind address. Only 127.0.0.1, localhost or ::1 are accepted.
MIRSAD_HOST=127.0.0.1
# HTTP port (0 picks a free port).
MIRSAD_PORT=8787
# Database, evidence files and demo-credentials.json live here (git-ignored).
MIRSAD_DATA_DIR=./data
# Seed a demo workspace, officers, accounts and connector on first start with an empty database.
MIRSAD_DEMO_SEED=true

# Reviewer: lmstudio (local model), deterministic (offline rules) or disabled.
MIRSAD_REVIEWER=lmstudio
# LM Studio OpenAI-compatible endpoint; must be a loopback URL.
MIRSAD_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Model ID loaded in LM Studio (Qwen3.5 9B Q4_K_M).
MIRSAD_LMSTUDIO_MODEL=qwen3.5-9b
# Context length the model is loaded with.
MIRSAD_LMSTUDIO_CONTEXT_TOKENS=4096
# Per-request timeout in milliseconds.
MIRSAD_LMSTUDIO_TIMEOUT_MS=120000
# Number of chats reviewed in parallel (one review at a time per chat).
MIRSAD_REVIEW_CONCURRENCY=2
# Comma-separated capture methods that may be reviewed. telegram_business_live is never allowed.
MIRSAD_REVIEW_ALLOWED_CAPTURE_METHODS=fixture_replay

# Number of event-stream events kept per workspace.
MIRSAD_STREAM_RETENTION=5000
# Requests per minute allowed per token.
MIRSAD_RATE_LIMIT_PER_MINUTE=600

# WhatsApp import gate. Rejected at startup unless a valid Telegram controlled-test record exists.
MIRSAD_WHATSAPP_IMPORT_ENABLED=false

# Telegram live connector (read-only business updates). Stays off unless every value below is set.
TELEGRAM_LIVE_ENABLED=false
# Bot token from BotFather (secret: set only in .env).
TELEGRAM_BOT_TOKEN=
# Business connection ID approved for the controlled test.
TELEGRAM_APPROVED_CONNECTION_ID=
# Comma-separated chat IDs approved for the controlled test.
TELEGRAM_APPROVED_CHAT_IDS=
# Reference of the written approval for the controlled test.
TELEGRAM_APPROVAL_REFERENCE=
